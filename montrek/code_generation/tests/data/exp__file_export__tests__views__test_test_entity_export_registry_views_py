class TestTestEntityExportTriggerView(ProcessPipelineViewTestCase):
    """Exercises the export wiring: URL, view, manager and registry write.

    TestEntityFileExportProcessor is stubbed out so this runs green before the
    processor exists. Once it is implemented, drop ``_stub_processor``, build the
    data the export needs in ``build_factories`` and adjust the expectations below.
    """

    viewname = "test_entity_export_trigger"
    view_class = TestEntityExportTriggerView
    expected_message = "Export successful"
    expected_status = "processed"

    def build_factories(self):
        # TODO: Remove once TestEntityFileExportProcessor is implemented and
        # create the records the export is supposed to write out instead.
        self._stub_processor()

    def _stub_processor(self):
        def process(processor) -> bool:
            processor.set_result_file(
                ContentFile(b"col1,col2\ncell1,cell2\n", name="test_entity_export.csv")
            )
            processor.set_message(self.expected_message)
            return True

        stubs = {
            "pre_check": lambda processor: True,
            "process": process,
            "post_check": lambda processor: True,
        }
        for method_name, stub in stubs.items():
            patcher = patch.object(
                TestEntityFileExportProcessor, method_name, stub
            )
            patcher.start()
            self.addCleanup(patcher.stop)

    def expected_url(self) -> str:
        return reverse("test_entity_export_registry_list")

    def additional_assertions(self):
        registry = TestEntityExportRegistryRepository().receive().first()
        self.assertTrue(
            bool(registry.export_file),
            "export_file should be set after a successful export",
        )


