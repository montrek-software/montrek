###########################################
# Runtime configuration. Copy to .env.
#
# Build- and CI-time credentials (registry login, SonarQube token) belong in
# .env.build instead -- see .env.build.template. Everything in this file is
# injected into the application containers.
#
# Secrets do not have to live here. `make secrets-init` moves each one into its
# own file under secrets/, which docker compose then mounts read-only at
# /run/secrets in only the services that need it -- so it no longer appears in
# `docker inspect` or in the environment of every child process. The values
# marked "-> secrets/<name>" below are the ones it takes. Anything still set
# here keeps working and takes precedence, so migrating is optional and
# reversible. See docs/secrets.md.
###########################################

###########################################
# App Config
###########################################

NAVBAR_APPS=""
PROJECT_NAME=<<Your project name>>
DEPLOY_PORT=443
DEPLOY_HOST= <<Your IP Address>>

###########################################
# Client Config
###########################################

#CLIENT_LOGO_PATH="<<url or filename>>"
#PRIMARY_COLOR=< Client companies primary color >
#SECONDARY_COLOR=< Client companies secondary color >

###########################################
# Container image
#
# Which image the stack runs, and what `make git-build-montrek-container`
# tags and pushes. Not secret, and it must live here rather than in
# .env.build: compose interpolates these and only reads .env.
#
# For a self-hosted Forgejo registry set the HOST only -- the namespace and
# image name are appended, giving
# forgejo.montrek-software.de/montrek-software/montrek-container:latest
###########################################

# CONTAINER_REGISTRY=ghcr.io
# CONTAINER_NAMESPACE=montrek-software
# CONTAINER_IMAGE=montrek-container
# CONTAINER_TAG=latest

###########################################
#Django Config
###########################################

# -> secrets/secret_key
SECRET_KEY=< A strong password >
DEBUG=0
APP_PORT=8000
ADMIN_EMAIL=<a mail address which gives acces to admin features>
# Django superuser password. Used ONLY for the Django admin: give Keycloak and
# Flower their own credentials below rather than reusing this one.
# -> secrets/admin_password
ADMIN_PASSWORD=< A strong password >
LOG_LEVEL="INFO"

###########################################
# DB Config
###########################################

DB_ENGINE=postgres
DB_NAME=montrek_db # Change if multiple dbs are running
DB_USER=montrekuser
# -> secrets/db_password
DB_PASSWORD=<<Password>>
DB_HOST=db
DB_PORT=5432

# Backup format written by `make docker-db-backup`: `custom` is pg_dump's
# compressed binary archive (restored with pg_restore), `plain` the legacy SQL
# text dump. A restore reads either, whichever this is set to.
#DB_BACKUP_FORMAT=custom
# Backups older than this are pruned unless they are the last one of a month.
#DB_BACKUP_KEEP_DAYS=30


###########################################
# Email Config
###########################################

#EMAIL_HOST=
#EMAIL_HOST_USER=
# -> secrets/email_host_password
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=True
#EMAIL_PORT=587

###########################################
# Celery Config
###########################################

CELERY_BROKER_URL=redis://redis:6379
CELERY_RESULT_BACKEND=redis://redis:6379
CELERY_TASK_ALWAYS_EAGER=0
FLOWER_PORT=5557
# Basic-auth password for the Flower UI (user: admin). Falls back to
# ADMIN_PASSWORD when unset; set it so a leaked Flower password is not also the
# Django superuser password.
# -> secrets/flower_password
#FLOWER_PASSWORD=< A strong password >

###########################################
# Keycloak Config
###########################################

#KEYCLOAK_PORT=8080
# -> secrets/keycloak_db_password
#KEYCLOAK_DB_PASSWORD=
# Keycloak realm admin. Falls back to ADMIN_PASSWORD when unset; set it.
# -> secrets/keycloak_admin_password
#KEYCLOAK_ADMIN_PASSWORD=
#KEYCLOAK_REALM=
#KEYCLOAK_CLIENT_ID=
# -> secrets/keycloak_client_secret
#KEYCLOAK_CLIENT_SECRET=
#
