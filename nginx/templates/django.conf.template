# Django Application
server {
    listen ${DEPLOY_PORT} ssl;
    server_name ${PROJECT_NAME}.${DEPLOY_HOST};

    ssl_certificate     ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};

    client_max_body_size 100M;

    # Resolve the upstream per request rather than at config load, so a
    # stopped container yields a 502 here instead of stopping nginx.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    location /static/ {
        alias /montrek/static/;
    }

    # Uploads go through Django, which checks the login and answers with an
    # X-Accel-Redirect into this location (MEDIA_X_ACCEL_REDIRECT). internal
    # keeps it from being requested directly.
    location /protected-uploads/ {
        internal;
        alias /montrek/uploads/;
        # Django's own headers are not kept when nginx serves the file.
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        set $upstream_url http://web:${APP_PORT};
        proxy_pass $upstream_url;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
