# Django Application
server {
    listen ${DEPLOY_PORT} ssl;
    server_name ${PROJECT_NAME}.${DEPLOY_HOST};

    ssl_certificate     ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};

    client_max_body_size 100M;

    # Resolve the upstream per request rather than at config load, so a
    # stopped container yields a 502 here instead of stopping nginx.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    location /static/ {
        alias /montrek/static/;
    }

    location /uploads/ {
        alias /montrek/uploads/;
        expires 30d;
        add_header Cache-Control "public";
    }

    location / {
        set $upstream_url http://web:${APP_PORT};
        proxy_pass $upstream_url;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
